/dts-v1/;

/ {
	compatible = "beagle,light\0thead,light-val\0thead,light";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "BeagleBoard.org BeagleV-Ahead";

	aliases {
		ethernet0 = "/soc/ethernet@ffe7070000";
		ethernet1 = "/soc/ethernet@ffe7060000";
		gpio0 = "/soc/gpio@ffec005000";
		gpio1 = "/soc/gpio@ffec006000";
		gpio2 = "/soc/gpio@ffe7f34000";
		gpio3 = "/soc/gpio@ffe7f38000";
		i2c0 = "/soc/i2c@ffe7f20000";
		i2c1 = "/soc/i2c@ffe7f24000";
		i2c2 = "/soc/i2c@ffec00c000";
		i2c3 = "/soc/i2c@ffec014000";
		i2c4 = "/soc/i2c@ffe7f28000";
		audio_i2c0 = "/soc/i2c@0xffcb01a000";
		audio_i2c1 = "/soc/i2c@0xffcb01b000";
		mmc0 = "/soc/sdhci@ffe7080000";
		mmc1 = "/soc/sd@ffe7090000";
		serial0 = "/soc/serial@ffe7014000";
		serial1 = "/soc/serial@ffe7f00000";
		serial2 = "/soc/serial@ffec010000";
		serial3 = "/soc/serial@ffe7f04000";
		serial4 = "/soc/serial@fff7f08000";
		serial5 = "/soc/serial@fff7f0c000";
		spi0 = "/soc/spi@ffe700c000";
		spi1 = "/soc/spi@ffea000000";
		spi2 = "/soc/spi@fff8000000";
		flash_led0 = "/soc/vvcam_flash_led@0";
		vivcam0 = "/soc/vvcam_sensor@0";
		vivcam1 = "/soc/vvcam_sensor@1";
		vivcam2 = "/soc/vvcam_sensor@2";
		vivcam3 = "/soc/vvcam_sensor@3";
		vivcam4 = "/soc/vvcam_sensor@4";
		vivcam5 = "/soc/vvcam_sensor@5";
		vivcam6 = "/soc/vvcam_sensor@6";
		viv_video0 = "/soc/cam_dev@100";
		viv_video1 = "/soc/cam_dev@200";
		viv_video2 = "/soc/cam_dev@300";
		viv_video3 = "/soc/cam_dev@400";
		viv_video4 = "/soc/cam_dev@500";
		viv_video5 = "/soc/cam_dev@600";
		viv_video6 = "/soc/cam_dev@700";
		viv_video7 = "/soc/cam_dev@800";
		viv_video8 = "/soc/cam_dev@900";
		viv_video9 = "/soc/cam_dev@a00";
		viv_video10 = "/soc/cam_dev@b00";
		viv_video11 = "/soc/cam_dev@c00";
		viv_video12 = "/soc/cam_dev@d00";
		viv_video13 = "/soc/cam_dev@e00";
		viv_video14 = "/soc/cam_dev@f00";
		viv_video15 = "/soc/cam_dev@f01";
		mikrobus0 = "/linux-mikrobus";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x200000 0x00 0xffe00000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x180>;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x14000000>;
			alloc-ranges = <0x00 0x64000000 0x00 0x14000000>;
			linux,cma-default;
			phandle = <0x181>;
		};

		memory@1c000000 {
			reg = <0x00 0x1c000000 0x00 0x2000000>;
			no-map;
			phandle = <0x182>;
		};

		memory@20000000 {
			reg = <0x00 0x20000000 0x00 0x280000 0x00 0x20280000 0x00 0x1000 0x00 0x20281000 0x00 0x7000 0x00 0x20288000 0x00 0x178000>;
			no-map;
			phandle = <0x4c>;
		};

		memory@20400000 {
			reg = <0x00 0x20400000 0x00 0x280000 0x00 0x20680000 0x00 0x1000 0x00 0x20681000 0x00 0x7000 0x00 0x20688000 0x00 0x178000>;
			no-map;
			phandle = <0x4d>;
		};

		framebuffer@10000000 {
			reg = <0x00 0x10000000 0x00 0x2c00000 0x00 0x12c00000 0x00 0x1d00000 0x00 0x14900000 0x00 0x1e00000>;
			no-map;
			phandle = <0x3c>;
		};

		memory@17000000 {
			reg = <0x00 0x17000000 0x00 0x2000000>;
			no-map;
			phandle = <0x3b>;
		};

        /* START CHANGES */
		benchmark_memory: benchmark-region@82000000 {
			/* no-map prevents Linux from creating page tables for this region */
			no-map;

			/* <[MSB Address] [LSB Address] [MSB Size] [LSB Size]> */
			/* This reserves 96 MB starting at 0x82000000 */
			reg = <0x00 0x82000000 0x00 0x6000000>;
		};
        /* END CHANGES */

	};

	thermal-zones {

		cpu-thermal-zone {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x7d0>;
			thermal-sensors = <0x01 0x00>;

			trips {

				trip0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x02>;
				};

				trip1 {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x183>;
				};
			};

			cooling-maps {

				cpu_cdev {
					trip = <0x02>;
					cooling-device = <0x03 0xffffffff 0xffffffff 0x04 0xffffffff 0xffffffff 0x05 0xffffffff 0xffffffff 0x06 0xffffffff 0xffffffff>;
				};
			};
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		timebase-frequency = <0x2dc6c0>;
		phandle = <0x184>;

		cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			status = "okay";
			compatible = "riscv";
			riscv,isa = "rv64imafdcvsu";
			mmu-type = "riscv,sv39";
			cpu-freq = "1.848Ghz";
			cpu-icache = "64KB";
			cpu-dcache = "64KB";
			cpu-l2cache = "1MB";
			cpu-tlb = "1024 4-ways";
			cpu-cacheline = "64Bytes";
			cpu-vector = "0.7.1";
			#cooling-cells = <0x02>;
			operating-points = <0x493e0 0x9eb10 0xc3500 0xaae60 0x16e360 0xc3500 0x1c32c0 0xf4240>;
			light,dvddm-operating-points = <0x493e0 0xc3500 0xc3500 0xc3500 0x16e360 0xc3500 0x1c32c0 0xf4240>;
			clock-latency = <0xee6c>;
			clocks = <0x07 0x1b0 0x07 0x00 0x07 0x72 0x07 0x189>;
			clock-names = "c910_cclk\0c910_cclk_i0\0cpu_pll1_foutpostdiv\0cpu_pll0_foutpostdiv";
			dvdd-supply = <0x08>;
			dvddm-supply = <0x09>;
			phandle = <0x03>;

			interrupt-controller {
				#interrupt-cells = <0x01>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				phandle = <0x0d>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			reg = <0x01>;
            /* START CHANGES */
			//status = "disabled";
            /* END CHANGES */
			compatible = "riscv";
			riscv,isa = "rv64imafdcvsu";
			mmu-type = "riscv,sv39";
			cpu-freq = "1.848Ghz";
			cpu-icache = "64KB";
			cpu-dcache = "64KB";
			cpu-l2cache = "1MB";
			cpu-tlb = "1024 4-ways";
			cpu-cacheline = "64Bytes";
			cpu-vector = "0.7.1";
			#cooling-cells = <0x02>;
			operating-points = <0x493e0 0x9eb10 0xc3500 0xaae60 0x16e360 0xc3500 0x1c32c0 0xf4240>;
			light,dvddm-operating-points = <0x493e0 0xc3500 0xc3500 0xc3500 0x16e360 0xc3500 0x1c32c0 0xf4240>;
			clock-latency = <0xee6c>;
			clocks = <0x07 0x1b0 0x07 0x00 0x07 0x72 0x07 0x189>;
			clock-names = "c910_cclk\0c910_cclk_i0\0cpu_pll1_foutpostdiv\0cpu_pll0_foutpostdiv";
			dvdd-supply = <0x08>;
			dvddm-supply = <0x09>;
			phandle = <0x04>;

			interrupt-controller {
				#interrupt-cells = <0x01>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				phandle = <0x0e>;
			};
		};

		cpu@2 {
			device_type = "cpu";
			reg = <0x02>;
            /* START CHANGES */
			//status = "disabled";
            /* END CHANGES */
			compatible = "riscv";
			riscv,isa = "rv64imafdcvsu";
			mmu-type = "riscv,sv39";
			cpu-freq = "1.848Ghz";
			cpu-icache = "64KB";
			cpu-dcache = "64KB";
			cpu-l2cache = "1MB";
			cpu-tlb = "1024 4-ways";
			cpu-cacheline = "64Bytes";
			cpu-vector = "0.7.1";
			#cooling-cells = <0x02>;
			operating-points = <0x493e0 0x9eb10 0xc3500 0xaae60 0x16e360 0xc3500 0x1c32c0 0xf4240>;
			light,dvddm-operating-points = <0x493e0 0xc3500 0xc3500 0xc3500 0x16e360 0xc3500 0x1c32c0 0xf4240>;
			clock-latency = <0xee6c>;
			clocks = <0x07 0x1b0 0x07 0x00 0x07 0x72 0x07 0x189>;
			clock-names = "c910_cclk\0c910_cclk_i0\0cpu_pll1_foutpostdiv\0cpu_pll0_foutpostdiv";
			dvdd-supply = <0x08>;
			dvddm-supply = <0x09>;
			phandle = <0x05>;

			interrupt-controller {
				#interrupt-cells = <0x01>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				phandle = <0x0f>;
			};
		};

		cpu@3 {
			device_type = "cpu";
			reg = <0x03>;
            /* START CHANGES */
			//status = "disabled";
            /* END CHANGES */
			compatible = "riscv";
			riscv,isa = "rv64imafdcvsu";
			mmu-type = "riscv,sv39";
			cpu-freq = "1.848Ghz";
			cpu-icache = "64KB";
			cpu-dcache = "64KB";
			cpu-l2cache = "1MB";
			cpu-tlb = "1024 4-ways";
			cpu-cacheline = "64Bytes";
			cpu-vector = "0.7.1";
			#cooling-cells = <0x02>;
			operating-points = <0x493e0 0x9eb10 0xc3500 0xaae60 0x16e360 0xc3500 0x1c32c0 0xf4240>;
			light,dvddm-operating-points = <0x493e0 0xc3500 0xc3500 0xc3500 0x16e360 0xc3500 0x1c32c0 0xf4240>;
			clock-latency = <0xee6c>;
			clocks = <0x07 0x1b0 0x07 0x00 0x07 0x72 0x07 0x189>;
			clock-names = "c910_cclk\0c910_cclk_i0\0cpu_pll1_foutpostdiv\0cpu_pll0_foutpostdiv";
			dvdd-supply = <0x08>;
			dvddm-supply = <0x09>;
			phandle = <0x06>;

			interrupt-controller {
				#interrupt-cells = <0x01>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				phandle = <0x10>;
			};
		};
	};

	display-subsystem {
		compatible = "verisilicon,display-subsystem";
		ports = <0x0a 0x0b>;
		status = "okay";
	};

	dpu-encoders {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		dpu-encoder@0 {
			compatible = "verisilicon,dsi-encoder";
			reg = <0x00>;
			status = "disabled";
			phandle = <0x185>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x0c>;
						phandle = <0x28>;
					};
				};
			};
		};

		dpu-encoder@1 {
			compatible = "verisilicon,dsi-encoder";
			reg = <0x01>;
			status = "disabled";
			phandle = <0x186>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
			};
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x187>;

		reset-sample {
			compatible = "thead,reset-sample";
			plic-delegate = <0xff 0xd81ffffc>;
			entry-reg = <0xff 0xff019050>;
			entry-cnt = <0x04>;
			control-reg = <0xff 0xff015004>;
			control-val = <0x1c>;
			csr-copy = <0x7f3 0x7c0 0x7c1 0x7c2 0x7c3 0x7c5 0x7cc>;
			phandle = <0x188>;
		};

		clint@ffdc000000 {
			compatible = "riscv,clint0";
			interrupts-extended = <0x0d 0x03 0x0d 0x07 0x0e 0x03 0x0e 0x07 0x0f 0x03 0x0f 0x07 0x10 0x03 0x10 0x07>;
			reg = <0xff 0xdc000000 0x00 0x4000000>;
			clint,has-no-64bit-mmio;
			phandle = <0x189>;
		};

		interrupt-controller@ffd8000000 {
			#interrupt-cells = <0x01>;
			compatible = "riscv,plic0";
			interrupt-controller;
			interrupts-extended = <0x0d 0xffffffff 0x0d 0x09 0x0e 0xffffffff 0x0e 0x09 0x0f 0xffffffff 0x0f 0x09 0x10 0xffffffff 0x10 0x09>;
			reg = <0xff 0xd8000000 0x00 0x4000000>;
			reg-names = "control";
			riscv,max-priority = <0x07>;
			riscv,ndev = <0xf0>;
			phandle = <0x12>;
		};

		clocks {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			apb-clock@0 {
				compatible = "fixed-clock";
				reg = <0x00>;
				clock-frequency = <0x3b9aca0>;
				clock-output-names = "dummy_clock_apb";
				#clock-cells = <0x00>;
				phandle = <0x15>;
			};

			ref-clock@1 {
				compatible = "fixed-clock";
				reg = <0x01>;
				clock-frequency = <0x2faf080>;
				clock-output-names = "dummy_clock_ref";
				#clock-cells = <0x00>;
				phandle = <0x2e>;
			};

			suspend-clock@2 {
				compatible = "fixed-clock";
				reg = <0x02>;
				clock-frequency = <0x2faf080>;
				clock-output-names = "dummy_clock_suspend";
				#clock-cells = <0x00>;
				phandle = <0x2f>;
			};

			rtc-clock@3 {
				compatible = "fixed-clock";
				reg = <0x03>;
				clock-frequency = <0x8000>;
				clock-output-names = "dummy_clock_rtc";
				#clock-cells = <0x00>;
				phandle = <0x2b>;
			};

			ahb-clock@4 {
				compatible = "fixed-clock";
				reg = <0x04>;
				clock-frequency = <0x2faf080>;
				clock-output-names = "dummy_clock_ahb";
				#clock-cells = <0x00>;
				phandle = <0x18a>;
			};

			gpu-clock@6 {
				compatible = "fixed-clock";
				reg = <0x06>;
				clock-frequency = <0x112a880>;
				clock-output-names = "dummy_clock_gpu";
				#clock-cells = <0x00>;
				phandle = <0x18b>;
			};

			dphy-ref-clock@7 {
				compatible = "fixed-clock";
				reg = <0x07>;
				clock-frequency = <0x16e3600>;
				clock-output-names = "dummy_clock_dphy_ref";
				#clock-cells = <0x00>;
				phandle = <0x18c>;
			};

			dphy-cfg-clock@8 {
				compatible = "fixed-clock";
				reg = <0x08>;
				clock-frequency = <0x16e3600>;
				clock-output-names = "dummy_clock_dphy_cfg";
				#clock-cells = <0x00>;
				phandle = <0x18d>;
			};

			dpu-pixel-clock@9 {
				compatible = "fixed-clock";
				reg = <0x09>;
				clock-frequency = <0x44aa200>;
				clock-output-names = "dummy_clock_dpu_pixel0";
				#clock-cells = <0x00>;
				phandle = <0x18e>;
			};

			dpu-pixel-clock@10 {
				compatible = "fixed-clock";
				reg = <0x0a>;
				clock-frequency = <0x46cf710>;
				clock-output-names = "dummy_clock_dpu_pixel1";
				#clock-cells = <0x00>;
				phandle = <0x18f>;
			};

			clock-osc-32k@11 {
				compatible = "fixed-clock";
				reg = <0x0b>;
				#clock-cells = <0x00>;
				clock-frequency = <0x8000>;
				clock-output-names = "osc_32k";
				phandle = <0x30>;
			};

			clock-osc-24m@12 {
				compatible = "fixed-clock";
				reg = <0x0c>;
				#clock-cells = <0x00>;
				clock-frequency = <0x16e3600>;
				clock-output-names = "osc_24m";
				phandle = <0x31>;
			};

			clock-rc-24m@13 {
				compatible = "fixed-clock";
				reg = <0x0d>;
				#clock-cells = <0x00>;
				clock-frequency = <0x16e3600>;
				clock-output-names = "rc_24m";
				phandle = <0x32>;
			};

			eip-clock@14 {
				compatible = "fixed-clock";
				reg = <0x0e>;
				clock-frequency = <0x17d78400>;
				clock-output-names = "dummy_clock_eip";
				#clock-cells = <0x00>;
				phandle = <0x4e>;
			};

			spi-clock@15 {
				compatible = "fixed-clock";
				reg = <0x0f>;
				clock-frequency = <0x179a7b00>;
				clock-output-names = "dummy_clock_spi";
				#clock-cells = <0x00>;
				phandle = <0x1a>;
			};

			spi-clock@16 {
				compatible = "fixed-clock";
				reg = <0x0f>;
				clock-frequency = <0x2f34f600>;
				clock-output-names = "dummy_clock_qspi";
				#clock-cells = <0x00>;
				phandle = <0x1d>;
			};

			gmac-ahb-clock@16 {
				compatible = "fixed-clock";
				reg = <0x10>;
				clock-frequency = <0xee6b280>;
				clock-output-names = "dummy_gmac_ahb";
				#clock-cells = <0x00>;
				phandle = <0x190>;
			};

			gmac-clock@17 {
				compatible = "fixed-clock";
				reg = <0x11>;
				clock-frequency = <0x1dcd6500>;
				clock-output-names = "dummy_clock_gmac";
				#clock-cells = <0x00>;
				phandle = <0x191>;
			};

			sdhci-clock@18 {
				compatible = "fixed-clock";
				reg = <0x12>;
				clock-frequency = <0xbcd3d80>;
				clock-output-names = "dummy_clock_sdhci";
				#clock-cells = <0x00>;
				phandle = <0x38>;
			};

			aonsys-clk-clock@19 {
				compatible = "fixed-clock";
				reg = <0x13>;
				clock-frequency = <0x4650000>;
				clock-output-names = "dummy_clock_aonsys_clk";
				#clock-cells = <0x00>;
				phandle = <0x17>;
			};

			uart-sclk-clock@20 {
				compatible = "fixed-clock";
				reg = <0x14>;
				clock-frequency = <0x5f5e100>;
				clock-output-names = "dummy_clock_uart_sclk";
				#clock-cells = <0x00>;
				phandle = <0x192>;
			};

			visys-dummy-clock@21 {
				compatible = "fixed-clock";
				reg = <0x15>;
				clock-frequency = <0x16e3600>;
				#clock-cells = <0x00>;
				phandle = <0x4b>;
			};
		};

		iso7816-card@fff7f30000 {
			compatible = "thead,light-iso7816-card";
			reg = <0xff 0xf7f30000 0x00 0x4000>;
			pinctrl-names = "default";
			pinctrl-0 = <0x11>;
			interrupts = <0x45>;
			interrupt-parent = <0x12>;
			status = "disabled";
			phandle = <0x193>;
		};

		teesys-reg@ffff200000 {
			compatible = "syscon";
			reg = <0xff 0xff200000 0x00 0x10000>;
			phandle = <0x13>;
		};

		visys-reg@ffe4040000 {
			compatible = "thead,light-visys-reg\0syscon";
			reg = <0xff 0xe4040000 0x00 0x1000>;
			status = "disabled";
			phandle = <0x44>;
		};

		dspsys-reg@ffef040000 {
			compatible = "thead,light-dspsys-reg\0syscon";
			reg = <0xff 0xef040000 0x00 0x1000>;
			status = "okay";
			phandle = <0x4f>;
		};

		audio_ioctrl@ffcb01d000 {
			compatible = "thead,light-audio-ioctrl-reg\0syscon";
			reg = <0xff 0xcb01d000 0x00 0x1000>;
			status = "okay";
			phandle = <0x3f>;
		};

		audio_cpr@ffcb000000 {
			compatible = "thead,light-audio-cpr-reg\0syscon";
			reg = <0xff 0xcb000000 0x00 0x1000>;
			status = "okay";
			phandle = <0x40>;
		};

		efuse@ffff210000 {
			compatible = "thead,light-fm-efuse\0syscon";
			reg = <0xff 0xff210000 0x00 0x10000>;
			thead,teesys = <0x13>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			phandle = <0x194>;

			mac-address@176 {
				reg = <0xb0 0x06>;
				phandle = <0x34>;
			};

			mac-address@184 {
				reg = <0xb8 0x06>;
				phandle = <0x36>;
			};
		};

