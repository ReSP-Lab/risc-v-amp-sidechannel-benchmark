	lightsound@1 {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Light-Sound-Card";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x24b>;

		simple-audio-card,dai-link@0 {
			reg = <0x00>;
			format = "i2s";

			cpu {
				sound-dai = <0x15f 0x00>;
			};

			codec {
				sound-dai = <0x160>;
			};
		};

		simple-audio-card,dai-link@1 {
			reg = <0x01>;
			format = "i2s";

			cpu {
				sound-dai = <0x161 0x00>;
			};

			codec {
				sound-dai = <0x162>;
			};
		};

		simple-audio-card,dai-link@2 {
			reg = <0x02>;
			format = "i2s";

			cpu {
				sound-dai = <0x163 0x01>;
			};

			codec {
				sound-dai = <0x164 0x02>;
			};
		};
	};

